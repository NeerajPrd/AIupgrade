[importlinter]
root_package = src
include_external_packages = True

[importlinter:contract:no-direct-redis]
name = Only backend modules may import redis
type = forbidden
source_modules =
    src.api
    src.services.agents
    src.services.tool_handlers
    src.services.google_workspace
forbidden_modules =
    redis

[importlinter:contract:no-direct-celery]
name = Only the celery backend may import celery
type = forbidden
source_modules =
    src.api
    src.services.agents
    src.services.tool_handlers
forbidden_modules =
    celery
ignore_imports =
    # src.tasks.workflow._revoke_celery_task checks get_settings().lite_mode
    # and returns before this import ever executes, so celery is never
    # actually imported in lite mode - this is a static-analysis false
    # positive on an already runtime-guarded deferred import.
    src.api.v1.routers.workflow.workflow_api -> src.tasks.workflow
    src.api.v1.routers.workflow.executions -> src.tasks.workflow
    # src.services.taskqueue.lite_tasks is the lite-mode, celery-free task
    # wrapper (see its module docstring) - it only reaches src.tasks.workflow
    # for shared business logic, never the celery-touching function.
    src.services.taskqueue.lite_tasks -> src.tasks.workflow
